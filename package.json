{
  "name": "lightweight-magic-charts",
  "version": "0.1.0",
  "description": "Embeddable chart workspace: domain types, data port and the executable conformance suite every adapter must pass.",
  "license": "Apache-2.0",
  "keywords": [
    "chart",
    "charting",
    "candlestick",
    "lightweight-charts",
    "react",
    "trading",
    "technical-analysis",
    "indicators",
    "workspace"
  ],
  "homepage": "https://github.com/marxms/lightweight-magic-charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marxms/lightweight-magic-charts.git"
  },
  "bugs": {
    "url": "https://github.com/marxms/lightweight-magic-charts/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "conformance": [
        "dist/conformance/suite.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/suite.d.ts",
      "import": "./dist/esm/conformance/suite.js",
      "require": "./dist/conformance/suite.js",
      "default": "./dist/conformance/suite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "conformance",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc && npm run build:esm",
    "test": "jest --config jest.config.js",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/finalise-esm.mjs",
    "example": "npm run build:esm && node example/serve.mjs",
    "layout-probe": "npm run build:esm && node scripts/layout-probe.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.25.12",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "lightweight-charts": ">=5.2.0 <6",
    "react": ">=18.0.0 <20"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
