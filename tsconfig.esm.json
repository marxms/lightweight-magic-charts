{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "./dist/esm"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "test"]
}
